# Finds gpuic's dependencies, downloading the ones that are missing.
#
#   GPUIC_DEPENDENCIES = AUTO   use what is installed, download the rest (default)
#                        SYSTEM never download; fail if something is missing
#                        FETCH  always download SDL3, FreeType, HarfBuzz and FriBidi
#   GPUIC_FONTCONFIG   = AUTO   use fontconfig when found, else scan font directories
#                        ON     require fontconfig
#                        OFF    scan font directories
#
# A target that already exists (the parent project built or found it first) is
# reused as is. Ends with the interface library gpuic_deps and the variables
# GPUIC_FETCHED (names of downloaded dependencies) and GPUIC_USES_FONTCONFIG.
include_guard(GLOBAL)
include(FetchContent)
find_package(PkgConfig QUIET)

# (The installed gpuicConfig.cmake sets both as plain variables first.)
if(NOT DEFINED GPUIC_DEPENDENCIES)
  set(GPUIC_DEPENDENCIES "FETCH" CACHE STRING "Where gpuic gets SDL3, FreeType, HarfBuzz and FriBidi: AUTO, SYSTEM or FETCH")
  set_property(CACHE GPUIC_DEPENDENCIES PROPERTY STRINGS AUTO SYSTEM FETCH)
endif()
if(NOT DEFINED GPUIC_FONTCONFIG)
  set(GPUIC_FONTCONFIG "AUTO" CACHE STRING "Use fontconfig for font fallback: AUTO, ON or OFF")
  set_property(CACHE GPUIC_FONTCONFIG PROPERTY STRINGS AUTO ON OFF)
endif()
if(NOT GPUIC_DEPENDENCIES MATCHES "^(AUTO|SYSTEM|FETCH)$")
  message(FATAL_ERROR "GPUIC_DEPENDENCIES must be AUTO, SYSTEM or FETCH (got '${GPUIC_DEPENDENCIES}')")
endif()
if(NOT GPUIC_FONTCONFIG MATCHES "^(AUTO|ON|OFF)$")
  message(FATAL_ERROR "GPUIC_FONTCONFIG must be AUTO, ON or OFF (got '${GPUIC_FONTCONFIG}')")
endif()

# Sources are pinned by hash: a changed upstream archive fails the configure step.
set(GPUIC_SDL3_URL "https://github.com/libsdl-org/SDL/releases/download/release-3.4.20/SDL3-3.4.20.tar.gz")
set(GPUIC_SDL3_HASH "SHA256=f3bb06f55bed9557227a700af2ea62e49497ebdf58037732a731a5fb3ef8581f")
set(GPUIC_FREETYPE_URL "https://github.com/freetype/freetype/archive/refs/tags/VER-2-14-3.tar.gz")
set(GPUIC_FREETYPE_HASH "SHA256=dc49de6b01a266eef4876a4dd34d9842c475d3e28ff2eff63bd2fb760ab56261")
set(GPUIC_HARFBUZZ_URL "https://github.com/harfbuzz/harfbuzz/releases/download/14.6.0/harfbuzz-14.6.0.tar.xz")
set(GPUIC_HARFBUZZ_HASH "SHA256=d07a007327277708a2a73ae437887cdbaf282937f6d03ca5467723e9099af586")
set(GPUIC_FRIBIDI_URL "https://github.com/fribidi/fribidi/releases/download/v1.0.17/fribidi-1.0.17.tar.xz")
set(GPUIC_FRIBIDI_HASH "SHA256=6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2")

set(GPUIC_FETCHED "")
set(_gpuic_targets "")

# pkg-config module -> global imported target named <out>; empty out var if not found.
function(_gpuic_pkgconfig out module)
  set(${out} "" PARENT_SCOPE)
  if(NOT PkgConfig_FOUND)
    return()
  endif()
  string(MAKE_C_IDENTIFIER "${module}" id)
  pkg_check_modules(GPUIC_PC_${id} QUIET IMPORTED_TARGET GLOBAL ${module})
  if(GPUIC_PC_${id}_FOUND)
    set(${out} PkgConfig::GPUIC_PC_${id} PARENT_SCOPE)
  endif()
endfunction()

function(_gpuic_want_system result)
  if(GPUIC_DEPENDENCIES STREQUAL "FETCH")
    set(${result} FALSE PARENT_SCOPE)
  else()
    set(${result} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_gpuic_missing name)
  if(GPUIC_DEPENDENCIES STREQUAL "SYSTEM")
    message(FATAL_ERROR "gpuic: ${name} was not found and GPUIC_DEPENDENCIES=SYSTEM forbids downloading it")
  endif()
  message(STATUS "gpuic: ${name} not found, downloading it")
endfunction()

# Settings for downloaded projects are plain variables, so they stay inside the
# functions below and never leak into the including project.
function(_gpuic_fetch_sdl3)
  set(SDL_SHARED OFF)
  set(SDL_STATIC ON)
  set(SDL_TESTS OFF)
  set(SDL_TEST_LIBRARY OFF)
  set(SDL_EXAMPLES OFF)
  set(SDL_INSTALL OFF)
  set(SDL_DISABLE_INSTALL_DOCS ON)
  FetchContent_Declare(gpuic_sdl3 URL ${GPUIC_SDL3_URL} URL_HASH ${GPUIC_SDL3_HASH} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(gpuic_sdl3)
endfunction()

function(_gpuic_fetch_freetype)
  # Compressed fonts use FreeType's own gzip; no optional libraries are pulled in
  # except libpng, which FreeType finds itself and which color emoji (CBDT) needs.
  set(BUILD_SHARED_LIBS OFF)
  set(FT_DISABLE_ZLIB ON)
  set(FT_DISABLE_BZIP2 ON)
  set(FT_DISABLE_BROTLI ON)
  set(FT_DISABLE_HARFBUZZ ON)
  set(SKIP_INSTALL_ALL ON)
  FetchContent_Declare(gpuic_freetype URL ${GPUIC_FREETYPE_URL} URL_HASH ${GPUIC_FREETYPE_HASH} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(gpuic_freetype)
endfunction()

function(_gpuic_fetch_harfbuzz)
  set(BUILD_SHARED_LIBS OFF)
  set(HB_HAVE_FREETYPE OFF)   # gpuic hands FreeType glyph data to HarfBuzz itself
  set(HB_HAVE_GLIB OFF)
  set(HB_HAVE_ICU OFF)
  set(HB_HAVE_GOBJECT OFF)
  set(HB_HAVE_CORETEXT OFF)
  set(HB_HAVE_DIRECTWRITE OFF)
  set(HB_HAVE_GDI OFF)
  set(HB_BUILD_UTILS OFF)
  set(HB_BUILD_SUBSET OFF)
  set(HB_BUILD_TESTS OFF)
  set(HB_BUILD_DOCS OFF)
  set(SKIP_INSTALL_ALL ON)
  FetchContent_Declare(gpuic_harfbuzz URL ${GPUIC_HARFBUZZ_URL} URL_HASH ${GPUIC_HARFBUZZ_HASH} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(gpuic_harfbuzz)
endfunction()

_gpuic_want_system(_system_ok)

# ---- SDL3 -----------------------------------------------------------------
if(NOT TARGET SDL3::SDL3 AND _system_ok)
  find_package(SDL3 CONFIG QUIET)
  if(NOT TARGET SDL3::SDL3)
    _gpuic_pkgconfig(_pc sdl3)
    if(_pc)
      add_library(gpuic_sdl3_system INTERFACE)
      target_link_libraries(gpuic_sdl3_system INTERFACE ${_pc})
      add_library(SDL3::SDL3 ALIAS gpuic_sdl3_system)
    endif()
  endif()
endif()
if(NOT TARGET SDL3::SDL3)
  _gpuic_missing(SDL3)
  _gpuic_fetch_sdl3()
  list(APPEND GPUIC_FETCHED SDL3)
endif()
list(APPEND _gpuic_targets SDL3::SDL3)

# ---- FreeType -------------------------------------------------------------
if(NOT TARGET Freetype::Freetype AND NOT TARGET freetype AND _system_ok)
  find_package(Freetype QUIET)
  if(NOT TARGET Freetype::Freetype)
    _gpuic_pkgconfig(_pc freetype2)
    if(_pc)
      add_library(gpuic_freetype_system INTERFACE)
      target_link_libraries(gpuic_freetype_system INTERFACE ${_pc})
      add_library(Freetype::Freetype ALIAS gpuic_freetype_system)
    endif()
  endif()
endif()
if(NOT TARGET Freetype::Freetype AND NOT TARGET freetype)
  _gpuic_missing(FreeType)
  _gpuic_fetch_freetype()
  list(APPEND GPUIC_FETCHED FreeType)
endif()
if(TARGET Freetype::Freetype)
  list(APPEND _gpuic_targets Freetype::Freetype)
else()
  list(APPEND _gpuic_targets freetype)
endif()

# ---- HarfBuzz -------------------------------------------------------------
if(NOT TARGET harfbuzz::harfbuzz AND NOT TARGET harfbuzz AND _system_ok)
  find_package(harfbuzz CONFIG QUIET)
  if(NOT TARGET harfbuzz::harfbuzz)
    _gpuic_pkgconfig(_pc harfbuzz)
    if(_pc)
      add_library(gpuic_harfbuzz_system INTERFACE)
      target_link_libraries(gpuic_harfbuzz_system INTERFACE ${_pc})
      add_library(harfbuzz::harfbuzz ALIAS gpuic_harfbuzz_system)
    endif()
  endif()
endif()
if(NOT TARGET harfbuzz::harfbuzz AND NOT TARGET harfbuzz)
  _gpuic_missing(HarfBuzz)
  _gpuic_fetch_harfbuzz()
  list(APPEND GPUIC_FETCHED HarfBuzz)
endif()
if(TARGET harfbuzz::harfbuzz)
  list(APPEND _gpuic_targets harfbuzz::harfbuzz)
else()
  list(APPEND _gpuic_targets harfbuzz)
endif()

# ---- FriBidi ----------------------------------------------------------------
if(NOT TARGET FriBidi::FriBidi AND _system_ok)
  _gpuic_pkgconfig(_pc fribidi)
  if(_pc)
    add_library(gpuic_fribidi_system INTERFACE)
    target_link_libraries(gpuic_fribidi_system INTERFACE ${_pc})
    add_library(FriBidi::FriBidi ALIAS gpuic_fribidi_system)
  endif()
endif()
if(NOT TARGET FriBidi::FriBidi)
  _gpuic_missing(FriBidi)
  FetchContent_Declare(gpuic_fribidi URL ${GPUIC_FRIBIDI_URL} URL_HASH ${GPUIC_FRIBIDI_HASH} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(gpuic_fribidi)   # no CMakeLists.txt upstream: this only downloads
  include("${CMAKE_CURRENT_LIST_DIR}/GpuicFriBidi.cmake")
  gpuic_add_fribidi("${gpuic_fribidi_SOURCE_DIR}")
  list(APPEND GPUIC_FETCHED FriBidi)
endif()
list(APPEND _gpuic_targets FriBidi::FriBidi)

# ---- fontconfig (optional) ----------------------------------------------------
# It cannot be downloaded: upstream builds with meson/autotools and needs
# generated sources. Without it gpuic scans the system font directories instead.
set(GPUIC_USES_FONTCONFIG FALSE)
if(NOT GPUIC_FONTCONFIG STREQUAL "OFF")
  if("FreeType" IN_LIST GPUIC_FETCHED)
    # fontconfig links the system FreeType, which would clash with the downloaded one.
    if(GPUIC_FONTCONFIG STREQUAL "ON")
      message(FATAL_ERROR "gpuic: GPUIC_FONTCONFIG=ON cannot be combined with a downloaded FreeType")
    endif()
    message(STATUS "gpuic: FreeType was downloaded, so fontconfig is not used (fonts come from directory scanning)")
  else()
    _gpuic_pkgconfig(_pc fontconfig)
    if(_pc)
      add_library(gpuic_fontconfig_system INTERFACE)
      target_link_libraries(gpuic_fontconfig_system INTERFACE ${_pc})
      list(APPEND _gpuic_targets gpuic_fontconfig_system)
      set(GPUIC_USES_FONTCONFIG TRUE)
    elseif(GPUIC_FONTCONFIG STREQUAL "ON")
      message(FATAL_ERROR "gpuic: GPUIC_FONTCONFIG=ON but fontconfig was not found")
    else()
      message(STATUS "gpuic: fontconfig not found, fonts come from directory scanning")
    endif()
  endif()
endif()

add_library(gpuic_deps INTERFACE)
target_link_libraries(gpuic_deps INTERFACE ${_gpuic_targets})
if(GPUIC_FETCHED)
  string(REPLACE ";" ", " _f "${GPUIC_FETCHED}")
  message(STATUS "gpuic: downloaded ${_f}")
endif()
